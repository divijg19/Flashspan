{
	"name": "flashspan",
	"private": true,
	"version": "2.8.2",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"lint": "biome check --write",
		"lint:check": "biome check",
		"typecheck": "tsc --noEmit",
		"format": "biome format --write",
		"build:wasm": "wasm-pack build ./src-tauri --release --target web --out-dir ../src/wasm/pkg --out-name flashspan_core",
		"build:web": "bun run build:wasm && bun run build",
		"preview": "vite preview",
		"test": "vitest --run"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.12.5",
		"solid-js": "^1.9.19"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.8",
		"@solidjs/testing-library": "^0.8.10",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/user-event": "^14.6.12",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "5.1.0",
		"jsdom": "^31.0.1",
		"typescript": "^7.0.2",
		"vite": "^8.3.8",
		"vite-plugin-solid": "^2.11.16",
		"vitest": "^5.1.0"
	}
}
