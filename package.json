{
	"name": "flashspan",
	"private": true,
	"version": "2.8.1",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"lint": "biome check . --write",
		"lint:check": "biome check .",
		"typecheck": "tsc --noEmit",
		"format": "biome format . --write",
		"build:wasm": "wasm-pack build ./src-tauri --release --target web --out-dir ../src/wasm/pkg --out-name flashspan_core",
		"build:web": "bun run build:wasm && bun run build",
		"preview": "vite preview",
		"test": "vitest --run"
	},
	"dependencies": {
		"@tauri-apps/api": "^2.12.4",
		"solid-js": "^1.9.17"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"@solidjs/testing-library": "^0.8.10",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/user-event": "^14.6.8",
		"@types/node": "^26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"jsdom": "^30.1.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vite-plugin-solid": "^2.11.14",
		"vitest": "^5.0.5"
	}
}
